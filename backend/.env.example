# ---------- Backend (set these in Render / Railway / Fly -> Environment) ----------
ENVIRONMENT=production

# REQUIRED in production (>= 32 chars). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# REQUIRED in production: your exact frontend origin(s), comma separated. "*" is refused.
ALLOWED_ORIGINS=https://lifora-rouge.vercel.app

# Postgres connection string from your host (postgres:// and postgresql:// both work)
DATABASE_URL=

# Used inside password-reset emails
FRONTEND_URL=https://lifora-rouge.vercel.app

# Optional - password reset emails (without SMTP the UI says reset email is not set up)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LIFORA <no-reply@your-domain.org>

# Behind Render/Railway/Fly the real client IP is in X-Forwarded-For
TRUST_PROXY=true

# Automated tests only (ignored when ENVIRONMENT=production): made-up demo users/data. Leave unset.
# SEED_DEMO_DATA=true
# ALLOW_DEMO_PASSWORDS=false

# Optional tuning
# ACCESS_TOKEN_EXPIRE_MINUTES=43200   # 30 days: people stay logged in
# AUTO_CONFIRM_HOURS=24               # an unanswered "I donated" counts after this many hours
# MIN_DONATIONS_TO_VERIFY=5           # donations needed before an admin can verify a donor
# MAX_REQUEST_EMAILS=200              # most donors e-mailed for one new request

# How many reverse proxies are in front of the app (Render/Railway/Fly = 1). Used for the real client IP.
TRUSTED_PROXY_COUNT=1

# Days between donations before a donor is matched again (whole blood).
DONATION_COOLDOWN_DAYS=120

# Database connection pool (PostgreSQL only)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
