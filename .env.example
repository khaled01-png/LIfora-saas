# ---------- Frontend (Vercel -> Project Settings -> Environment Variables) ----------
# Address of the LIFORA server, for example https://lifora-api.onrender.com/api
# REQUIRED when the site is published. While developing with `npm run dev` you can leave it empty
# (the local server at http://127.0.0.1:8000 is used). If it is missing on the live site, a red
# "server not reachable" notice is shown and nothing can be saved.
VITE_API_BASE_URL=

# Contact details shown in the footer and on the About page (shown only when set; nothing is invented):
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=

# Ads (optional). Leave empty = no ads. Shown only to signed-out visitors on public pages.
# Get both values from Google AdSense after your site is approved.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
# Set to true to also show ads to signed-in members (home and centers pages only). Default: guests only.
VITE_ADS_FOR_MEMBERS=false
